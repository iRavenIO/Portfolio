ASSISTANT_API_HOST=0.0.0.0
ASSISTANT_API_PORT=8787
ASSISTANT_CORS_ORIGIN=*

# Request limits per minute by tier
ASSISTANT_PUBLIC_RPM=20
ASSISTANT_AUTH_RPM=60
ASSISTANT_PRIV_RPM=120

# Tier tokens (set strong random values in real deployment)
ASSISTANT_USER_TOKEN=
ASSISTANT_PRIVILEGED_TOKEN=
ASSISTANT_HIGH_TRUST_TOKEN=

# Local bridge controls
LOCAL_TOOLS_ENABLED=false
LOCAL_AGENT_URL=http://100.100.100.10:7443
BACKEND_LOCAL_SHARED_SECRET=
