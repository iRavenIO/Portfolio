LOCAL_AGENT_HOST=127.0.0.1
LOCAL_AGENT_PORT=7443

# Shared with assistant-api
BACKEND_LOCAL_SHARED_SECRET=

# Emergency switch
AGENT_LOCKDOWN=false

# Allowed local actions
AGENT_ALLOWED_ACTIONS=hermes.health,hermes.profile.answer,hermes.calendar.book_draft,hermes.notify.template

# Hermes integration (optional in MVP)
HERMES_ENDPOINT=
HERMES_API_KEY=
HERMES_PROFILE_FILE=content/cv.md
