# Copy to services/admin-api/.env.local and set strong credentials.
PORTFOLIO_ADMIN_EMAIL=admin@example.com
PORTFOLIO_ADMIN_PASSWORD=change-me

# Local-only by default. Do not expose publicly without an auth proxy/VPN.
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=8791

# Maximum JSON body size for YAML saves.
ADMIN_MAX_BODY_BYTES=1000000

# MySQL-backed content storage. If unset, the admin API falls back to content/site.yaml.
PORTFOLIO_MYSQL_HOST=mysql-proxy.mysql.svc.cluster.local
PORTFOLIO_MYSQL_PORT=3306
PORTFOLIO_MYSQL_DATABASE=portfolio
PORTFOLIO_MYSQL_USER=portfolio_admin
PORTFOLIO_MYSQL_PASSWORD=change-me

# Used by the migration/seed job to create the database and app user.
PORTFOLIO_MYSQL_ADMIN_USER=root
PORTFOLIO_MYSQL_ADMIN_PASSWORD=change-me-root
