# env.claude.sample — Claude Factory Environment Configuration
# Copy to .claude/env.claude and customize values.
#
# PURPOSE: Non-secret configuration for Claude Factory scripts, MCP servers,
# and Ops tooling. This is NOT for application runtime secrets (use .env.local
# for those — see docs/INSTALL.md).
#
# SECURITY: This file should contain ONLY non-secret configuration.
# Never put API keys, passwords, tokens, or connection strings here.
# The .claude/env.claude file is gitignored and will not be committed.
#
# USAGE: Factory scripts automatically source .claude/env.claude if it exists.

# ─── Ops MCP Configuration ───────────────────────────────────────────────────

# Default timeout for ops discovery tools (milliseconds)
OPS_DISCOVERY_TIMEOUT=30000

# Maximum concurrent discovery tools in unified ops_discover
OPS_MAX_CONCURRENT=5

# Enable/disable specific discovery backends (true/false)
OPS_ENABLE_K8S=true
OPS_ENABLE_ARGOCD=true
OPS_ENABLE_POSTGRES=true
OPS_ENABLE_SUPABASE=true
OPS_ENABLE_S3=true
OPS_ENABLE_GITHUB=true
OPS_ENABLE_DOCKER=true
OPS_ENABLE_REDIS=true
OPS_ENABLE_ARGO_WORKFLOWS=true

# Approval workflow TTL (minutes)
OPS_APPROVAL_TTL_MINUTES=60

# ─── Observability ────────────────────────────────────────────────────────────

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log directory (relative to repo root or absolute)
LOG_DIR=.claude/logs

# Enable MCP server request logging (true/false)
MCP_REQUEST_LOGGING=false

# ─── Cache Configuration ─────────────────────────────────────────────────────

# Cache backend: sqlite, redis, or both
CACHE_BACKEND=sqlite

# Cache database path (relative to repo root or absolute)
CACHE_DB_PATH=.claude/cache/cache.db

# Default cache TTL (seconds)
CACHE_DEFAULT_TTL=300

# ─── Path Configuration ──────────────────────────────────────────────────────

# Override path to ctags binary (auto-detected if empty)
CTAGS_PATH=

# Override path to ripgrep binary (auto-detected if empty)
RG_PATH=

# Override path to gemini binary (auto-detected if empty)
GEMINI_PATH=

# ─── Feature Flags ───────────────────────────────────────────────────────────

# Enable voice notifications via macOS say (true/false)
ENABLE_VOICE_NOTIFY=true

# Enable repository map generation on cache init (true/false)
ENABLE_REPO_MAP=true

# Enable partial secret redaction for debugging (true/false, see secrets-and-env policy)
REDACT_PARTIAL=false

# ─── Shared Infrastructure Defaults ───────────────────────────────────────────

# Optional named kubeconfig paths for shared Atlantis clusters.
# Keep these blank in the template unless you want repo-local defaults.
KUBECONFIG_ATLANTIS_HA00=
KUBECONFIG_ATLANTIS_MASTER=
KUBECONFIG_ATLANTIS_PI=

# Optional shared infra endpoints and helper paths.
VAULT_ADDR=
VAULT_TERRAFORM_ROOT=
VICTORIA_LOGS_URL=
VAULT_DOC_PATH=
VAULT_KV_MOUNT=
VAULT_SHARED_MYSQL_PATH=
VAULT_SHARED_MINIO_PATH=
VAULT_SHARED_HARBOR_PATH=
VAULT_SHARED_GITHUB_SSH_PATH=
PROJECT_CONTEXT_FILE=
PROJECT_DATABASE_KIND=
PROJECT_SECRET_SOURCE_HINT=

# ─── Infrastructure Connections ──────────────────────────────────────────────
#
# SECURITY WARNING: The keys below are for connecting to external infrastructure.
# These are connection credentials and should be treated as SECRETS.
#
# - DO NOT commit this file with real values
# - DO NOT share these values in logs or error messages
# - USE environment-specific files (.claude/env.claude.local) for production values
# - ROTATE credentials regularly
#
# The factory's secrets-and-env.md policy automatically redacts these patterns
# from all MCP tool output.

# Kubernetes cluster configuration
KUBECONFIG=

# Argo CD connection (for ops_discover_argocd)
ARGOCD_SERVER=
ARGOCD_AUTH_TOKEN=
ARGOCD_USERNAME=
ARGOCD_PASSWORD=

# PostgreSQL connection string (for ops_discover_postgres)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Supabase connection (for ops_discover_supabase)
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# AWS credentials (for ops_discover_s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# GitHub personal access token (for ops_discover_github)
# Requires: repo, workflow scopes
GITHUB_TOKEN=

# Redis connection URL (for ops_discover_redis)
# Format: redis://[user:password@]host:port[/database]
REDIS_URL=
