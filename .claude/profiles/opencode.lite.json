{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      ".claude/cache/**",
      ".claude/logs/**",
      ".claude/memory/**",
      ".claude/mcp/node_modules/**",
      "tags"
    ]
  },
  "mcp": {
    "factory-ops": {
      "type": "local",
      "command": ["node", ".claude/mcp/server-ops.js"]
    },
    "factory-git": {
      "type": "local",
      "command": ["node", ".claude/mcp/server-git.js"]
    },
    "factory-fs": {
      "type": "local",
      "command": ["node", ".claude/mcp/server-fs.js"]
    }
  }
}
