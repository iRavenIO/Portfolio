# .env.example — Environment Variable Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ═══════════════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════════════

# PostgreSQL connection string
# Format: postgres://user:password@host:port/database
# Example: postgres://myuser:mypassword@localhost:5432/mydb
DATABASE_URL=

# ═══════════════════════════════════════════════════════════════════════
# SUPABASE
# ═══════════════════════════════════════════════════════════════════════

# Supabase project URL (public, safe to commit to frontend code)
# Get from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous key (public, rate-limited)
# Get from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (SECRET - server-side only, DO NOT expose to frontend)
# Get from: https://app.supabase.com/project/_/settings/api
# WARNING: This key bypasses Row Level Security. Never use in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# ═══════════════════════════════════════════════════════════════════════
# KUBERNETES / ARGO CD
# ═══════════════════════════════════════════════════════════════════════

# Kubernetes config file path (optional - defaults to ~/.kube/config)
# Recommendation: Use shell export or direnv instead of .env file
# KUBECONFIG=/path/to/kubeconfig

# Argo CD server URL (e.g., argocd.example.com)
ARGOCD_SERVER=

# Argo CD username (optional - prefer `argocd login` for local auth)
ARGOCD_USERNAME=

# Argo CD password (optional - prefer `argocd login` for local auth)
# WARNING: Storing passwords in .env is discouraged. Use `argocd login` instead.
ARGOCD_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════
# GITHUB
# ═══════════════════════════════════════════════════════════════════════

# GitHub repository (e.g., owner/repo)
GITHUB_REPO=

# GitHub authentication mode: ssh, https, or gh (GitHub CLI)
# Recommendation: Use 'gh' (GitHub CLI with `gh auth login`) or SSH agent
GITHUB_AUTH_MODE=ssh

# SSH private key path (path only, not the key content)
# Recommendation: Use SSH agent instead of storing path in .env
# GITHUB_SSH_KEY_PATH=~/.ssh/id_ed25519

# GitHub Personal Access Token (if using HTTPS)
# Get from: https://github.com/settings/tokens
# Recommendation: Use `gh auth login` instead
# GITHUB_TOKEN=

# ═══════════════════════════════════════════════════════════════════════
# CACHE
# ═══════════════════════════════════════════════════════════════════════

# Redis connection URL (optional)
# Format: redis://[user:password@]host:port[/db]
# Example: redis://localhost:6379/0
REDIS_URL=

# Cache backend: sqlite, redis, or memcached
# Default: sqlite (no external dependencies)
CACHE_BACKEND=sqlite

# ═══════════════════════════════════════════════════════════════════════
# NODE.JS / NEXT.JS
# ═══════════════════════════════════════════════════════════════════════

# Node environment: development, production, test
NODE_ENV=development

# Server port
PORT=3000

# ═══════════════════════════════════════════════════════════════════════
# SECURITY BEST PRACTICES
# ═══════════════════════════════════════════════════════════════════════
#
# 1. NEVER commit .env.local to git (it's in .gitignore)
# 2. Use separate .env.local per environment (dev, staging, prod)
# 3. Rotate secrets regularly (every 90 days recommended)
# 4. Use least-privilege access (don't reuse admin keys)
# 5. Prefer managed secrets (1Password, AWS Secrets Manager, Vault)
#
# WHERE TO STORE SECRETS:
# - KUBECONFIG: Shell export or direnv (not .env file)
# - ArgoCD: `argocd login` (local config), avoid storing password
# - Postgres: .env.local OR ~/.pgpass (preferred for CLI tools)
# - GitHub: `gh auth login` or SSH agent (never store private key in .env)
# - Supabase: .env.local for public URL/anon key; service role key server-side only
#
# IF SECRETS LEAK:
# 1. Rotate ALL affected secrets immediately
# 2. Revoke compromised tokens/keys
# 3. Audit access logs for unauthorized use
# 4. Review git history (consider BFG Repo-Cleaner if committed)
# 5. Update .gitignore if pattern was missed
#
# ═══════════════════════════════════════════════════════════════════════
